# YouMakeTV.ai — Environment Variables
# Copy this file to .env.local and fill in values to activate integrations.
# Never commit .env.local to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA_ID=

# ── Google Tag Manager ──────────────────────────────────────────────────────
# Get from: https://tagmanager.google.com → Admin → Container ID
# Format: GTM-XXXXXXX
VITE_GTM_ID=

# ── Meta (Facebook) Pixel ────────────────────────────────────────────────────
# Get from: https://business.facebook.com → Events Manager → Pixel ID
# Format: numeric ID (e.g. 1234567890)
VITE_META_PIXEL_ID=

# ── Canonical domain (used in sitemap / OG tags) ────────────────────────────
# Set to your production domain — no trailing slash
VITE_BASE_URL=https://youmaketv.ai

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY VARIABLES (Vercel → Project → Settings → Environment Variables)
# No VITE_ prefix: these must never be bundled into the browser build.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact form → Growth OS CRM ─────────────────────────────────────────────
# Full lead webhook URL, including its secret whk_ token. Unset = CRM sink is
# skipped and the contact form relies on the Resend email copy alone.
CRM_WEBHOOK_URL=https://growth-os-sand.vercel.app/api/hooks/whk_your-token-here

# ── Super Admin login (/superadmin) ──────────────────────────────────────────
# Checked server-side by /api/admin/login. Unset = admin login returns 503;
# there is no fallback credential anywhere in the code.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-admin-password
# Random secret used to sign 12h admin session tokens (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your-64-char-random-hex-string
